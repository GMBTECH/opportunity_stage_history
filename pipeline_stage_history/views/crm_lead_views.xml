<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="crm_lead_form_stage_history" model="ir.ui.view">
        <field name="name">crm.lead.form.stage.history</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Stage History"
                      name="stage_history" invisible="type == 'lead'">
                    <field name="stage_history_ids"
                           readonly="1">
                        <list default_order="changed_on desc" editable="top">
                            <field name="changed_on"/>
                            <field name="previous_stage_id"/>
                            <field name="new_stage_id"/>
                            <field name="changed_by"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>


    <!-- Search view with default grouping by Lead / Opportunity -->
    <record id="crm_stage_history_search_view" model="ir.ui.view">
        <field name="name">crm.stage.history.search</field>
        <field name="model">crm.stage.history</field>
        <field name="arch" type="xml">
            <search string="Stage Change History">
                <field name="lead_id"/>
                <field name="previous_stage_id"/>
                <field name="new_stage_id"/>
                <field name="changed_by"/>
                <filter
                        name="group_by_lead"
                        string="Lead / Opportunity"
                        context="{'group_by': 'lead_id'}"
                />

            </search>
        </field>
    </record>

    <!-- History list -->
    <record id="crm_stage_history_list_view" model="ir.ui.view">
        <field name="name">crm.stage.history.list</field>
        <field name="model">crm.stage.history</field>
        <field name="arch" type="xml">
            <list string="Stage Change History"
                  create="0"
                  edit="0"
                  delete="0"
                  default_order="changed_on desc">
                <field name="lead_id"/>
                <field name="previous_stage_id"/>
                <field name="new_stage_id"/>
                <field name="changed_by"/>
                <field name="changed_on"/>
            </list>
        </field>
    </record>

    <!-- Window action -->
    <record id="crm_stage_history_action" model="ir.actions.act_window">
        <field name="name">Stage Change History</field>
        <field name="res_model">crm.stage.history</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="crm_stage_history_search_view"/>
        <field name="context">
            {'search_default_group_by_lead': 1}
        </field>
    </record>

    <!-- Separate menu under CRM -->
    <menuitem
            id="crm_stage_history_menu"
            name="Stage Audit History"
            parent="crm.crm_menu_root"
            action="crm_stage_history_action"
            sequence="24"
            groups="base.group_user"
    />

</odoo>
